# ---- Boost.ai WebRTC voice entry points (client: SPANKKIRFP) --------------
# These already have working defaults baked into src/config.js, so you only
# need this file if the entry points ever change.
VITE_VOICE_SESSION_URL=https://SPANKKIRFP.boost.ai/api/voice/v1/session
VITE_VOICE_EXTERNAL_ID_FI=b46a8cb8-cdd9-492c-ac9b-1f77a3e5552f
VITE_VOICE_EXTERNAL_ID_EN=4613c31b-82f7-4d84-855c-8aecf297e084

# ---- Supabase (optional) ----------------------------------------------------
# Leave these blank to run the demo on local fallback customer data (useful
# for rehearsing before Supabase is wired up, or if Supabase is unreachable).
# Use the anon/publishable key ONLY — never a service-role key — and make
# sure Row Level Security restricts it to read-only access. See README.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CUSTOMERS_TABLE=s_pankki_customers

# ---- Optional future hook ---------------------------------------------------
# Only needed if you later add a call-session table so the Boost backend can
# drive authentication automatically instead of the presenter hotkey. See the
# "Going further" section of README.md. Leave blank for now.
VITE_SESSION_TABLE=
